// =============================================================================
// TECHNIKA SUPABASE POSTGRESQL PRISMA SCHEMA (v1.0 Production with System Events & Auditing)
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Participant {
  id                   String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  registrationId       String        @unique @map("registration_id") @db.VarChar(10)
  name                 String        @db.VarChar(255)
  college              String        @map("college") @db.VarChar(255)
  email                String        @db.VarChar(255)
  phone                String        @map("phone") @db.VarChar(20)
  gender               String        @db.VarChar(20)
  age                  Int           @default(18)
  course               String?       @db.VarChar(100)
  semester             String?       @db.VarChar(50)
  isVerified           Boolean       @default(false) @map("is_verified")
  isRegistrationFrozen Boolean       @default(false) @map("is_registration_frozen")
  updatedAt            DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz

  registrations        Registration[]
  attendances          Attendance[]
  teamMembers          TeamMember[]
  ledTeams             Team[]        @relation("TeamLeader")
  wonPrizes            Winner[]

  @@map("participants")
  @@index([registrationId])
  @@index([updatedAt])
}

model Event {
  id                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId           String         @unique @map("event_id") @db.VarChar(50)
  name              String         @db.VarChar(255)
  category          String         @db.VarChar(100)
  eventType         String         @default("COMPETITION") @map("event_type") @db.VarChar(50) // SYSTEM | COMPETITION
  lifecycleState    String         @default("SCANNING_OPEN") @map("lifecycle_state") @db.VarChar(50) // UPCOMING | REGISTRATION_OPEN | SCANNING_OPEN | SCANNING_CLOSED | WINNER_DECLARATION_OPEN | COMPLETED | LOCKED
  maxActiveDevices  Int            @default(1) @map("max_active_devices")
  description       String?        @db.Text
  venue             String?        @db.VarChar(255)
  day               String?        @db.VarChar(50)
  startTime         String?        @map("start_time") @db.VarChar(50)
  endTime           String?        @map("end_time") @db.VarChar(50)
  capacity          Int?           @default(100)
  individualAllowed Boolean        @default(true) @map("individual_allowed")
  teamAllowed       Boolean        @default(false) @map("team_allowed")
  minMembers        Int            @default(1) @map("min_members")
  maxMembers        Int            @default(1) @map("max_members")
  pointsFirst       Int            @default(10) @map("points_first")
  pointsSecond      Int            @default(7) @map("points_second")
  pointsThird       Int            @default(5) @map("points_third")
  isActive          Boolean        @default(true) @map("is_active")
  displayOrder      Int            @default(0) @map("display_order")
  updatedAt         DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz

  registrations     Registration[]
  teams             Team[]
  volunteers        Volunteer[]
  attendances       Attendance[]
  winners           Winner[]
  notifications     Notification[]

  @@map("events")
  @@index([eventId])
  @@index([eventType])
  @@index([lifecycleState])
}

model Team {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId      String        @unique @map("team_id") @db.VarChar(50)
  teamName    String?       @map("team_name") @db.VarChar(255)
  eventId     String        @map("event_id") @db.VarChar(50)
  leaderId    String        @map("leader_id") @db.VarChar(10)
  status      String        @default("forming") @db.VarChar(50)
  memberCount Int           @default(1) @map("member_count")
  updatedAt   DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz

  event       Event         @relation(fields: [eventId], references: [eventId], onDelete: Cascade)
  leader      Participant   @relation("TeamLeader", fields: [leaderId], references: [registrationId], onDelete: Cascade)
  members     TeamMember[]
  registrations Registration[]
  attendances Attendance[]
  winners     Winner[]

  @@map("teams")
  @@index([eventId])
  @@index([teamId])
}

model TeamMember {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId    String      @map("team_id") @db.VarChar(50)
  userId    String      @map("user_id") @db.VarChar(10)
  role      String      @default("Member") @db.VarChar(50)
  joinedAt  DateTime    @default(now()) @map("joined_at") @db.Timestamptz
  updatedAt DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  team      Team        @relation(fields: [teamId], references: [teamId], onDelete: Cascade)
  user      Participant @relation(fields: [userId], references: [registrationId], onDelete: Cascade)

  @@unique([teamId, userId])
  @@map("team_members")
  @@index([teamId])
  @@index([userId])
}

model Registration {
  id               String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  registrationId   String      @map("registration_id") @db.VarChar(10)
  eventId          String      @map("event_id") @db.VarChar(50)
  teamId           String?     @map("team_id") @db.VarChar(50)
  registrationType String      @default("INDIVIDUAL") @map("registration_type") @db.VarChar(20)
  status           String      @default("CONFIRMED") @db.VarChar(50)
  registeredAt     DateTime    @default(now()) @map("registered_at") @db.Timestamptz
  updatedAt        DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  participant      Participant @relation(fields: [registrationId], references: [registrationId], onDelete: Cascade)
  event            Event       @relation(fields: [eventId], references: [eventId], onDelete: Cascade)
  team             Team?       @relation(fields: [teamId], references: [teamId], onDelete: SetNull)

  @@unique([registrationId, eventId])
  @@map("registrations")
  @@index([eventId, registrationId])
}

model Volunteer {
  id                 String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  volunteerId        String       @unique @map("volunteer_id") @db.VarChar(50)
  name               String       @db.VarChar(255)
  passwordHash       String       @map("password_hash") @db.VarChar(255)
  assignedEventId    String       @map("assigned_event_id") @db.VarChar(50)
  activeSessionToken String?      @map("active_session_token") @db.Text
  activeDeviceId     String?      @map("active_device_id") @db.VarChar(255)
  lastLoginAt        DateTime?    @map("last_login_at") @db.Timestamptz
  isActive           Boolean      @default(true) @map("is_active")
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz

  assignedEvent      Event        @relation(fields: [assignedEventId], references: [eventId], onDelete: Restrict)
  scannedAttendances Attendance[]
  verifiedWinners    Winner[]     @relation("WinnerDeclaredBy")
  modifiedWinners    Winner[]     @relation("WinnerModifiedBy")

  @@map("volunteers")
  @@index([volunteerId, isActive])
  @@index([assignedEventId])
}

model Attendance {
  id                   String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId              String      @map("event_id") @db.VarChar(50)
  registrationId       String      @map("registration_id") @db.VarChar(10)
  teamId               String?     @map("team_id") @db.VarChar(50)
  scannedByVolunteerId String      @map("scanned_by") @db.VarChar(50)
  deviceId             String?     @map("device_id") @db.VarChar(255)
  scanMode             String      @default("ONLINE") @map("scan_mode") @db.VarChar(20) // ONLINE | OFFLINE
  scanTime             DateTime    @default(now()) @map("scan_time") @db.Timestamptz
  syncTime             DateTime    @default(now()) @map("sync_time") @db.Timestamptz
  deviceTimestamp      DateTime    @map("device_timestamp") @db.Timestamptz
  offlineSyncId        String      @unique @map("offline_sync_id") @db.VarChar(100)
  present              Boolean     @default(true) @map("present")
  createdAt            DateTime    @default(now()) @map("created_at") @db.Timestamptz

  event                Event       @relation(fields: [eventId], references: [eventId], onDelete: Restrict)
  participant          Participant @relation(fields: [registrationId], references: [registrationId], onDelete: Restrict)
  team                 Team?       @relation(fields: [teamId], references: [teamId], onDelete: SetNull)
  scannedBy            Volunteer   @relation(fields: [scannedByVolunteerId], references: [volunteerId])

  @@unique([eventId, registrationId])
  @@map("attendance")
  @@index([eventId, registrationId])
  @@index([scanTime])
}

model Winner {
  id                     String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId                String      @map("event_id") @db.VarChar(50)
  position               Int         @map("position")
  registrationId         String?     @map("registration_id") @db.VarChar(10)
  teamId                 String?     @map("team_id") @db.VarChar(50)
  pointsAwarded          Int         @map("points_awarded")
  declaredByVolunteerId  String      @map("declared_by") @db.VarChar(50)
  declaredAt             DateTime    @default(now()) @map("declared_at") @db.Timestamptz
  lastModifiedBy         String?     @map("last_modified_by") @db.VarChar(50)
  lastModifiedAt         DateTime    @default(now()) @updatedAt @map("last_modified_at") @db.Timestamptz
  remarks                String?     @db.Text

  event                  Event       @relation(fields: [eventId], references: [eventId], onDelete: Restrict)
  participant            Participant? @relation(fields: [registrationId], references: [registrationId], onDelete: Restrict)
  team                   Team?       @relation(fields: [teamId], references: [teamId], onDelete: Restrict)
  declaredBy             Volunteer   @relation("WinnerDeclaredBy", fields: [declaredByVolunteerId], references: [volunteerId])
  modifiedBy             Volunteer?  @relation("WinnerModifiedBy", fields: [lastModifiedBy], references: [volunteerId])

  @@unique([eventId, position])
  @@map("winners")
  @@index([eventId])
}

model SyncLog {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  syncType     String    @map("sync_type") @db.VarChar(50)
  status       String    @db.VarChar(50)
  startedAt    DateTime  @map("started_at") @db.Timestamptz
  completedAt  DateTime? @map("completed_at") @db.Timestamptz
  durationMs   Int?      @map("duration_ms")
  addedCount   Int       @default(0) @map("added_count")
  updatedCount Int       @default(0) @map("updated_count")
  deletedCount Int       @default(0) @map("deleted_count")
  failedCount  Int       @default(0) @map("failed_count")
  details      Json?     @db.JsonB
  errorMessage String?   @map("error_message") @db.Text
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@map("sync_logs")
}

model Notification {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title         String    @db.VarChar(255)
  message       String    @map("message") @db.Text
  priority      String    @default("Normal") @db.VarChar(20)
  targetEventId String?   @map("target_event_id") @db.VarChar(50)
  expiresAt     DateTime? @map("expires_at") @db.Timestamptz
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz

  targetEvent   Event?    @relation(fields: [targetEventId], references: [eventId], onDelete: Cascade)

  @@map("notifications")
}

model Contact {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @db.VarChar(255)
  phone       String   @db.VarChar(20)
  designation String   @db.VarChar(100)
  priority    Int      @default(1)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("contacts")
}
