# ==============================================================================
# TECHNIKA BACKEND MICROSERVICES ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application Service Mode: all | sync | leaderboard
SERVICE_MODE=all
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# MongoDB Atlas Configuration (Master Source of Truth - Read-Only Connection)
# ------------------------------------------------------------------------------
MONGODB_URI=mongodb+srv://admin:San123456789@technika.pzyvkza.mongodb.net/?appName=technika
MONGODB_DB_NAME=test

# ------------------------------------------------------------------------------
# Supabase PostgreSQL Configuration
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Direct connection for Prisma if migrating directly
DATABASE_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# Synchronization Engine Parameters
# ------------------------------------------------------------------------------
# Sync interval in seconds (default: 30 seconds for real-time mobile updates)
CRON_SYNC_INTERVAL_SEC=30
SYNC_BATCH_SIZE=500
ENABLE_AUTO_CRON_SYNC=true

# ------------------------------------------------------------------------------
# Security, JWT & Rate Limiting
# ------------------------------------------------------------------------------
JWT_SECRET=technika_volunteer_jwt_super_secret_key_2026
JWT_EXPIRY=24h
ADMIN_API_KEY=technika_master_admin_secret_key_2026
CORS_ORIGIN=*
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
