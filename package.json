{
  "name": "technika-backend",
  "version": "1.0.0",
  "description": "Technika Production Backend Microservices - Sync Service & Leaderboard Volunteer Service",
  "main": "dist/src/index.js",
  "scripts": {
    "build": "npx -p typescript tsc",
    "test": "node --loader tsx/esm --test test/backend.test.ts",
    "start": "node dist/src/index.js",
    "start:sync": "cross-env SERVICE_MODE=sync node dist/apps/sync-service/src/index.js",
    "start:leaderboard": "cross-env SERVICE_MODE=leaderboard node dist/apps/leaderboard-service/src/index.js",
    "start:all": "cross-env SERVICE_MODE=all node dist/src/index.js",
    "dev": "npx tsx watch src/index.ts",
    "dev:sync": "cross-env SERVICE_MODE=sync npx tsx watch apps/sync-service/src/index.ts",
    "dev:leaderboard": "cross-env SERVICE_MODE=leaderboard npx tsx watch apps/leaderboard-service/src/index.ts",
    "prisma:generate": "npx prisma generate",
    "prisma:push": "npx prisma db push"
  },
  "keywords": [
    "technika",
    "sync-service",
    "leaderboard",
    "volunteer-scanner",
    "microservices",
    "supabase",
    "mongodb"
  ],
  "author": "Technika Core Team",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^5.18.0",
    "@supabase/supabase-js": "^2.45.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.3",
    "node-cron": "^3.0.3",
    "pino": "^9.3.2",
    "pino-pretty": "^11.2.2",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.14",
    "@types/node-cron": "^3.0.11",
    "@types/swagger-ui-express": "^4.1.6",
    "cross-env": "^7.0.3",
    "prisma": "^5.18.0",
    "tsx": "^4.17.0",
    "typescript": "^5.5.4"
  }
}
